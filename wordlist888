<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>专升本核心词汇888 · 交互练习</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='4' y='6' width='24' height='22' rx='3' fill='%231F4E79'/%3E%3Cpath d='M10 12h12M10 17h12M10 22h7' stroke='%23fff' stroke-width='2.2' stroke-linecap='round'/%3E%3C/svg%3E">
<style>
:root{
  --theme:#1F4E79; --assoc:#2E6DA4; --bg:#F2F6FA; --line:#D9E2EC;
  --ink:#22262B; --sub:#5A6675; --ok:#1E8E5A; --err:#C0392B;
  --card:#FFFFFF; --radius:12px;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{background:var(--bg);color:var(--ink);font-family:-apple-system,"PingFang SC","Helvetica Neue","Microsoft YaHei",sans-serif}
button{font-family:inherit}
.wrap{max-width:720px;margin:0 auto;padding:14px 14px 40px}

/* ---------- 顶栏 ---------- */
.topbar{display:flex;align-items:center;gap:10px;margin-bottom:12px;min-height:44px}
.topbar .back{background:none;border:1px solid var(--line);border-radius:10px;width:44px;height:44px;font-size:18px;color:var(--theme);cursor:pointer;flex:0 0 44px}
.topbar .bt{flex:1;min-width:0}
.topbar h1{font-size:17px;color:var(--theme);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.topbar .sub{font-size:12px;color:var(--sub);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* ---------- 首页 ---------- */
.hero{padding:18px 4px 8px}
.hero h1{font-size:24px;color:var(--theme);letter-spacing:.5px}
.hero p{font-size:13px;color:var(--sub);margin-top:4px}
.hint{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0 4px}
.hint span{font-size:12px;color:var(--sub);background:#fff;border:1px solid var(--line);padding:5px 10px;border-radius:20px}
.units{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:12px}
@media (min-width:560px){.units{grid-template-columns:repeat(3,1fr)}}
.u-card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:13px 14px;cursor:pointer;display:block;text-align:left;width:100%;min-height:0}
.u-card.wide{grid-column:1/-1}
.u-card:active{transform:scale(.98)}
.u-card .un{font-size:12px;color:var(--assoc);font-weight:600}
.u-card .th{font-size:14px;color:var(--ink);margin-top:3px;line-height:1.4}
.u-card .meta{display:flex;justify-content:space-between;align-items:center;margin-top:8px;font-size:12px;color:var(--sub)}
.u-card .pct{font-size:13px;font-weight:700;color:var(--theme)}
.pbar{height:5px;background:#E4EBF2;border-radius:3px;margin-top:7px;overflow:hidden}
.pbar i{display:block;height:100%;background:var(--theme);border-radius:3px;width:0}
.usage{font-size:11px;color:var(--sub);text-align:center;margin-top:20px;line-height:1.7}

/* ---------- 题型导航 ---------- */
.tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:12px}
.tab{border:1px solid var(--line);background:#fff;border-radius:10px;padding:9px 4px;font-size:12.5px;color:var(--sub);cursor:pointer;position:relative}
.tab.on{background:var(--theme);border-color:var(--theme);color:#fff;font-weight:600}
.tab .done{position:absolute;top:-6px;right:-4px;background:var(--ok);color:#fff;font-size:10px;border-radius:10px;padding:1px 6px;display:none}
.tab .done.show{display:block}
.prog{font-size:12px;color:var(--sub);margin-bottom:10px;display:flex;justify-content:space-between;align-items:center}

/* ---------- 题卡 ---------- */
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:18px 16px;margin-bottom:12px}
.q-word{font-size:30px;font-weight:700;color:var(--theme);letter-spacing:.5px;display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap}
.spk{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border:2px solid var(--assoc);color:var(--assoc);background:#fff;border-radius:50%;cursor:pointer;flex:none;transition:.15s}
.spk:active{transform:scale(.92);background:#E8F1FA}
.spk svg{width:20px;height:20px}
.q-meta{font-size:13px;color:var(--sub);margin-top:4px}
.opts{display:grid;gap:8px}
.opt{display:flex;align-items:center;gap:10px;background:#fff;border:1.5px solid var(--line);border-radius:10px;padding:13px 14px;font-size:15px;cursor:pointer;text-align:left;min-height:50px;width:100%}
.opt .tag{flex:0 0 26px;height:26px;border-radius:7px;background:var(--bg);color:var(--theme);font-weight:700;display:flex;align-items:center;justify-content:center;font-size:13px}
.opt.correct{background:#EAF6F0;border-color:var(--ok)}
.opt.wrong{background:#FBEFED;border-color:var(--err)}
.opt:disabled{cursor:default}
.opt.done{opacity:.92}
/* ---------- 题型1 导航（上一题/下一题） ---------- */
.navrow{display:flex;gap:10px;margin-top:14px;max-width:420px;margin-left:auto;margin-right:auto}
.navbtn{flex:1;min-height:46px;border:2px solid var(--assoc);background:#fff;color:var(--theme);border-radius:10px;font-size:15px;font-weight:600;cursor:pointer;transition:.15s}
.navbtn:active{transform:scale(.97)}
.navbtn.main{background:var(--theme);border-color:var(--theme);color:#fff}
.navbtn:disabled{opacity:.38;cursor:not-allowed}

/* ---------- 反馈条 ---------- */
.fb{margin-top:12px;padding:12px 14px;border-radius:10px;font-size:14px;line-height:1.6;display:none}
.fb.show{display:block}
.fb.ok{background:#EAF6F0;border:1px solid #BBDECB;color:#14532D}
.fb.no{background:#FBEFED;border:1px solid #F0C4BE;color:#7B241C}
.fb .big{font-weight:700}

/* ---------- 输入（题型2） ---------- */
.inrow{display:flex;gap:8px;margin-top:14px}
.inrow input{flex:1;min-width:0;font-size:16px;padding:13px 12px;border:1.5px solid var(--line);border-radius:10px;outline:none;background:#fff}
.inrow input:focus{border-color:var(--theme)}
.btn{background:var(--theme);color:#fff;border:none;border-radius:10px;padding:0 20px;font-size:15px;font-weight:600;cursor:pointer;min-height:50px;white-space:nowrap}
.btn.ghost{background:#fff;color:var(--theme);border:1.5px solid var(--theme)}
.btn:disabled{opacity:.5;cursor:default}

/* ---------- 题型3 ---------- */
.pool{display:flex;flex-wrap:wrap;gap:8px;margin:4px 0 14px;background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:12px}
.pool .chip{background:#fff;border:1.5px solid var(--assoc);color:var(--theme);border-radius:8px;padding:8px 12px;font-size:14px;cursor:pointer;min-height:42px;display:inline-flex;align-items:center}
.pool .chip.used{opacity:.3;border-style:dashed;pointer-events:none}
.sent{display:block;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin-bottom:8px;font-size:15px;line-height:1.8}
.sent .slot{display:inline-block;min-width:96px;border-bottom:2px dashed var(--assoc);color:var(--assoc);font-weight:600;cursor:pointer;text-align:center;padding:2px 8px;border-radius:4px}
.sent .slot.active{background:#E4EEF9;border-bottom-style:solid}
.sent .slot.filled{color:var(--theme);border-bottom-style:solid}
.sent .slot.good{color:var(--ok);border-color:var(--ok);background:#EAF6F0}
.sent .slot.bad{color:var(--err);border-color:var(--err);background:#FBEFED}
.sent .slot.edit{border-style:solid;background:#fff}
.sent .ok-mark{color:var(--ok);font-weight:700;margin-left:4px}
.sent .no-mark{color:var(--err);font-weight:700;margin-left:4px}
.sin{width:104px;border:none;border-bottom:2px solid var(--theme);font-size:15px;font-family:inherit;color:var(--theme);outline:none;background:transparent;padding:2px 4px}
.form-hint{font-size:12px;color:#B45309;font-weight:600}
.t3score{font-size:14px;font-weight:700;color:var(--theme);text-align:center;margin:10px 0}

/* ---------- 小结 / 总结 ---------- */
.tally{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:16px;margin-bottom:12px}
.tally .tt{font-size:15px;font-weight:700;color:var(--theme);margin-bottom:8px}
.tally .row{display:flex;justify-content:space-between;font-size:14px;padding:5px 0;border-bottom:1px dashed #EDF1F5}
.tally .row:last-child{border-bottom:none}
.mask{position:fixed;inset:0;background:rgba(20,28,40,.45);display:none;align-items:center;justify-content:center;padding:20px;z-index:50}
.mask.show{display:flex}
.dialog{background:#fff;border-radius:14px;padding:22px 18px;width:100%;max-width:400px;max-height:86vh;overflow:auto}
.dialog h2{font-size:18px;color:var(--theme);margin-bottom:12px}
.dialog .row{display:flex;justify-content:space-between;font-size:14px;padding:6px 0;border-bottom:1px dashed #EDF1F5}
.dialog .row:last-of-type{border-bottom:none}
.dialog .big{font-size:20px;font-weight:700;color:var(--theme)}
.dbtn{display:block;width:100%;margin-top:10px;padding:13px;border-radius:10px;font-size:15px;font-weight:600;cursor:pointer;border:none}
.dbtn.main{background:var(--theme);color:#fff}
.dbtn.ghost{background:#fff;color:var(--theme);border:1.5px solid var(--theme)}

/* ---------- 错词页 ---------- */
.wlist{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:14px 16px;margin-bottom:12px}
.wlist .wt{font-size:15px;font-weight:700;color:var(--err);margin-bottom:10px}
.wrow{display:flex;gap:10px;padding:8px 0;border-bottom:1px dashed #EDF1F5;font-size:14px;align-items:baseline}
.wrow:last-child{border-bottom:none}
.wrow .w{font-weight:700;color:var(--ink);min-width:0}
.wrow .g{color:var(--sub);font-size:13px}
.empty{color:var(--sub);font-size:14px;text-align:center;padding:20px 0}
.note{font-size:12px;color:var(--sub);line-height:1.7}
.hide{display:none}
</style>
</head>
