    T2.copyMode=true;T2.copyWord=w.w;
    fb.className='fb no show';
    fb.innerHTML='<span class="big">&#10007; 不对</span>　正确答案是 <b>'+esc(w.w)+'</b>（'+esc(w.g)+'）<br>请把正确答案<b>抄写一遍</b>后按回车，强化记忆';
    inp.value='';inp.focus();
  }
}
function finishT2(){
  var p=pget(curUnit.id);
  $('stage').innerHTML='<div class="tally"><div class="tt">题型2 中译英 完成</div>'+
    '<div class="row"><span>答对</span><b>'+T2.right+' / '+T2.queue.length+'</b></div>'+
    '<div class="row"><span>累计正确率</span><b>'+(p.t2.total?Math.round(100*p.t2.ok/p.t2.total)+'%':'--')+'</b></div>'+
    '<button class="dbtn ghost" style="margin-top:12px" onclick="startT2()">再刷一遍</button></div>';
  $('d2').classList.add('show');
  $('progLine').textContent='题型2 完成，可切换到下一题型';
}

/* ================= 题型3：选词填空 ================= */
var T3={slots:[],score:0,pool:[]};
/* ================= 题型3：选词填空（支持适当形式） ================= */
function rootMatch(w,a){
  w=String(w).toLowerCase();a=String(a).toLowerCase();
  if(w===a)return true;
  if(a===w+'s'||a===w+'es'||a===w+'d'||a===w+'ed'||a===w+'ing')return true;
  if(w.length>1&&w.slice(-1)==='y'&&a===w.slice(0,-1)+'ies')return true;
  if(w.slice(-1)==='e'&&(a===w+'d'||a===w.slice(0,-1)+'ing'||a===w.slice(0,-1)+'s'))return true;
  if(w.length>=3&&'bcdfghjklmnpqrstvwxyz'.indexOf(w.slice(-1))>=0&&a===w+w.slice(-1)+'ed')return true;
  if(w.length>=3&&'bcdfghjklmnpqrstvwxyz'.indexOf(w.slice(-1))>=0&&a===w+w.slice(-1)+'ing')return true;
  return false;
}
function findOrig(ans,ws){
  for(var i=0;i<ws.length;i++)if(rootMatch(ws[i],ans))return ws[i];
  return ans;
}
var T3={slots:[],score:0,pool:[],active:-1,edit:-1};
function startT3(){
  var u=curUnit,pc=u.pc;
  if(!pc.ws.length){$('stage').innerHTML='<div class="empty">本单元暂无选词填空数据</div>';$('progLine').textContent='';return}
  var pool=shuffle(pc.ws.slice());
  var slots=[];
  for(var i=0;i<pc.it.length;i++)slots.push({word:null,ans:pc.an[i],orig:findOrig(pc.an[i],pc.ws),state:'empty',hint:''});
  T3={slots:slots,score:0,pool:pool,active:-1,edit:-1};
  renderT3();
}
function renderT3(){
  var u=curUnit,pc=u.pc,html='';
  html+='<div class="pool" id="pool">';
  T3.pool.forEach(function(w,i){
    html+='<button class="chip" data-i="'+i+'" data-w="'+esc(w)+'">'+esc(w)+'</button>';
  });
  html+='</div>';
  html+='<div class="t3score" id="t3s"></div>';
  pc.it.forEach(function(sent,si){
    var s=T3.slots[si];
    html+='<div class="sent">'+(si+1)+'. ';
    var parts=sent.split('___');
    parts.forEach(function(seg,pi){
      html+=esc(seg);
      if(pi<parts.length-1){
        var cls='slot';
        if(s.state==='good')cls+=' good';else if(s.state==='bad'||s.state==='form')cls+=' bad';else if(s.word)cls+=' filled';
        if(T3.active===si)cls+=' active';
        var slotTxt;
        if(T3.edit===si){
          cls+=' edit';
          slotTxt='<input class="sin" data-si="'+si+'" value="'+esc(s.word||'')+'" autocomplete="off" autocapitalize="off" spellcheck="false">';
        }else if(s.state==='good')slotTxt=esc(s.word)+' <span class="ok-mark">&#10003;</span>';
        else if(s.state==='bad'||s.state==='form')slotTxt=esc(s.ans)+' <span class="no-mark">&#10007;</span>';
        else slotTxt=s.word?esc(s.word):'点此选词';
        html+='<span class="'+cls+'" data-si="'+si+'">'+slotTxt+'</span>';
        if(s.state==='form'&&s.hint)html+=' <span class="form-hint">'+s.hint+'</span>';
      }
    });
    html+='</div>';
  });
  $('stage').innerHTML=html;
  $('progLine').innerHTML='<span>题型3 选词填空</span><span>已填 '+filledCount()+' / 10</span>';
  document.querySelectorAll('#pool .chip').forEach(function(c){c.onclick=function(){pickChip(+c.getAttribute('data-i'))}});
  document.querySelectorAll('.slot').forEach(function(sl){sl.onclick=function(){clickSlot(+sl.getAttribute('data-si'))}});
  if(T3.edit>=0){
    var inp=document.querySelector('.sin');
    if(inp){inp.focus();inp.select();inp.onkeydown=function(e){if(e.key==='Enter')submitSlot(T3.edit);if(e.key==='Escape'){T3.edit=-1;renderT3()}}}
  }
  if(T3.score>0)$('t3s').textContent='本题得分：'+T3.score+' / 10';
}
function filledCount(){var n=0;T3.slots.forEach(function(s){if(s.word)n++});return n}
function pickChip(i){
  var w=T3.pool[i];
  var si=-1;
  if(T3.active>=0&&!T3.slots[T3.active].word)si=T3.active;
  else{for(var k=0;k<T3.slots.length;k++)if(!T3.slots[k].word){si=k;break}}
  if(si<0)return;
  T3.slots[si].word=w;
  T3.pool.splice(i,1);
  T3.active=-1;
  checkSlot(si);
}
function clickSlot(si){
  var s=T3.slots[si];
  if(T3.edit===si){T3.edit=-1;renderT3();return}
  if(s.state==='form'){ // 形式不对：点击进入编辑，改成适当形式
    T3.edit=si;renderT3();return;
  }
  if(s.state==='good'||s.state==='bad'){ // 已判定：点击取出重填
    T3.pool.push(s.word);T3.slots[si].word=null;s.state='empty';s.hint='';T3.edit=-1;renderT3();return;
  }
  if(s.word){ // 已填未判：点击进入编辑
    T3.edit=(T3.edit===si?-1:si);renderT3();return;
  }
  T3.active=(T3.active===si?-1:si);renderT3();
}
function submitSlot(si){
  var s=T3.slots[si],inp=document.querySelector('.sin');
  var val=inp?inp.value.trim():'';
  if(!val){ // 清空回车 = 取出重填
    T3.pool.push(s.word);T3.slots[si].word=null;s.state='empty';s.hint='';T3.edit=-1;renderT3();return;
  }
  s.word=val;T3.edit=-1;checkSlot(si);
}
function checkSlot(si){
  var s=T3.slots[si],p=pget(curUnit.id);
  var val=s.word.toLowerCase(),ans=s.ans.toLowerCase(),orig=s.orig.toLowerCase();
  if(val===ans){s.state='good';p.t3.ok++;T3.score++;s.hint=''}
  else if(val===orig&&orig!==ans){
    s.state='form';s.hint='注意形式：'+esc(s.orig)+' → '+esc(s.ans);
    addWrong(curUnit.id,s.orig);
  }
  else{
    s.state='bad';s.hint='';
    addWrong(curUnit.id,s.orig);
  }
  p.t3.total++;save();
  renderT3();
  if(filledCount()===T3.slots.length)setTimeout(finishT3,600);
}
function finishT3(){
  var p=pget(curUnit.id);
  $('stage').innerHTML='<div class="tally"><div class="tt">题型3 选词填空 完成</div>'+
    '<div class="row"><span>本题得分</span><b>'+T3.score+' / 10</b></div>'+
    '<div class="row"><span>累计正确率</span><b>'+(p.t3.total?Math.round(100*p.t3.ok/p.t3.total)+'%':'--')+'</b></div>'+
    '<button class="dbtn ghost" style="margin-top:12px" onclick="startT3()">再刷一遍</button></div>';
  $('d3').classList.add('show');
  $('progLine').textContent='题型3 完成';
  // 三题型齐了，弹总结
  var done=p.t1.total>0&&p.t2.total>0&&p.t3.total>0;
  if(done&&!p.done){p.done=true;save();showSum()}
}

/* ================= 总结 ================= */
function showSum(){
  var p=pget(curUnit.id);
  $('sumTitle').textContent=curUnit.name+' 总结';
  $('sumBody').innerHTML=
    '<div class="row"><span>题型1 英选中</span><b>'+p.t1.ok+' / '+p.t1.total+'</b></div>'+
    '<div class="row"><span>题型2 中译英</span><b>'+p.t2.ok+' / '+p.t2.total+'</b></div>'+
    '<div class="row"><span>题型3 选词填空</span><b>'+p.t3.ok+' / '+p.t3.total+'</b></div>'+
    '<div class="row"><span>掌握率</span><b class="big">'+pct(curUnit.id)+'%</b></div>'+
    '<div class="row"><span>错词数</span><b>'+(p.wrong.length?p.wrong.length+' 个':'0，太稳了')+'</b></div>';
  $('maskSum').classList.add('show');
}
$('btnRerunWrong').onclick=function(){$('maskSum').classList.remove('show');openReview()};
$('btnSumHome').onclick=function(){$('maskSum').classList.remove('show');renderHome();show('home')};

/* ================= 错词回顾 ================= */
function openReview(){
  var p=pget(curUnit.id);
  $('rTitle').textContent=curUnit.name+' · 错词回顾';
  var box=$('reviewBox');
  if(!p.wrong.length){
    box.innerHTML='<div class="empty">本单元没有错词，继续保持</div>';
    return;
  }
  var html='<div class="wlist"><div class="wt">错词本（'+p.wrong.length+' 个）</div>';
  p.wrong.forEach(function(w){
    var g='';
    for(var i=0;i<ALL_WORDS.length;i++)if(ALL_WORDS[i].w===w&&ALL_WORDS[i].u===curUnit.id){g=ALL_WORDS[i].g;break}
    html+='<div class="wrow"><span class="w">'+esc(w)+'</span><span class="g">'+esc(g)+'</span></div>';
  });
  html+='</div><button class="btn" style="width:100%" id="btnRewrong">一键重刷错词（'+p.wrong.length+' 个）</button>';
  box.innerHTML=html;
  $('btnRewrong').onclick=startWrongQuiz;
  show('review');
}
function startWrongQuiz(){
  var p=pget(curUnit.id),wl=p.wrong.slice();
  if(!wl.length)return;
  // 在 review 页渲染题型1模式
  S={t:1,idx:0};
  T1={queue:wl.map(function(w){
    for(var i=0;i<ALL_WORDS.length;i++)if(ALL_WORDS[i].w===w&&ALL_WORDS[i].u===curUnit.id)return ALL_WORDS[i];
    return {w:w,ph:'',pos:'',g:''};
  }),right:0,now:null,lock:false};
  $('progLine').innerHTML='<span>错词重刷（英选中）</span><span>第 1 / '+wl.length+' 题</span>';
  renderWrongQ();
}
function renderWrongQ(){
  var p=pget(curUnit.id);
  if(S.idx>=T1.queue.length){ // 结束
    $('reviewBox').innerHTML='<div class="tally"><div class="tt">错词重刷完成</div>'+
      '<div class="row"><span>剩余错词</span><b>'+(p.wrong.length?p.wrong.length+' 个':'0 个，全部拿下')+'</b></div>'+
      '<button class="dbtn ghost" style="margin-top:12px" onclick="openReview()">查看错词本</button>'+
      '<button class="dbtn main" style="margin-top:8px" onclick="renderHome();show(\'home\')">返回首页</button></div>';
    $('progLine').textContent='重刷完成，做对的已移出错词本';
    return;
  }
  var w=T1.queue[S.idx];T1.now=w;
  var dis=distractor(w,3).map(function(x){return {w:x.w,g:x.g,pos:x.pos,right:false}});
  var opts=shuffle([{w:w.w,g:w.g,pos:w.pos,right:true}].concat(dis));
  var letters=['A','B','C','D'];
  var html='<div class="card"><div class="q-word">'+esc(w.w)+'</div>'+
    '<div class="q-meta">'+esc(w.ph||'')+(w.pos?'&nbsp; '+esc(w.pos):'')+'</div></div><div class="opts">';
  opts.forEach(function(o,i){html+='<button class="opt" data-i="'+i+'" data-right="'+o.right+'"><span class="tag">'+letters[i]+'</span><span>'+esc(o.g)+'</span></button>'});
  html+='</div><div class="fb" id="fbRW"></div>';
  $('reviewBox').innerHTML=html;
  $('progLine').innerHTML='<span>错词重刷（英选中）</span><span>第 '+(S.idx+1)+' / '+T1.queue.length+' 题</span>';
  var btns=$('reviewBox').querySelectorAll('.opt');
  for(var i=0;i<btns.length;i++)btns[i].onclick=function(){if(T1.lock)return;pickWrong(this)};
}
function pickWrong(btn){
  T1.lock=true;var p=pget(curUnit.id),w=T1.now;
  var isRight=btn.getAttribute('data-right')==='true';
  var letters=['A','B','C','D'],si=+btn.getAttribute('data-i');
  var opts=$('reviewBox').querySelectorAll('.opt');
  for(var k=0;k<opts.length;k++){var rb=opts[k].getAttribute('data-right')==='true';opts[k].disabled=true;if(rb)opts[k].classList.add('correct')}
  var fb=$('fbRW');fb.classList.add('show');
  if(isRight){
    btn.classList.add('correct');
    removeWrong(curUnit.id,w.w);
    p.t1.ok++;p.t1.total++;save();
    fb.className='fb ok show';fb.innerHTML='<span class="big">&#10003; 正确</span>　'+esc(w.g)+'（已移出错词本）';
    setTimeout(function(){T1.lock=false;S.idx++;renderWrongQ()},1000);
  }else{
    btn.classList.add('wrong');
    p.t1.total++;save();
    fb.className='fb no show';
    fb.innerHTML='<span class="big">&#10007; 还差一点</span>　'+esc(w.w)+' 是「'+esc(w.g)+'」，下次再战';
    setTimeout(function(){T1.lock=false;S.idx++;renderWrongQ()},1600);
  }
}

/* ================= 事件绑定 ================= */
$('btnBack').onclick=function(){renderHome();show('home')};
$('btnRBack').onclick=function(){renderHome();show('home')};
document.querySelectorAll('.tab').forEach(function(b){
  b.onclick=function(){if(curUnit)switchTab(+b.getAttribute('data-t'))};
});
$('maskSum').onclick=function(e){if(e.target===$('maskSum'))$('maskSum').classList.remove('show')};

renderHome();
</script>
