/* ================= 工具 ================= */
function $(id){return document.getElementById(id)}
function shuffle(a){for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t}return a}
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
function levenshtein(a,b){
  var m=a.length,n=b.length;if(m===0)return n;if(n===0)return m;
  var p=new Array(n+1),c=new Array(n+1),i,j;
  for(j=0;j<=n;j++)p[j]=j;
  for(i=1;i<=m;i++){c[0]=i;for(j=1;j<=n;j++){var cost=a[i-1]===b[j-1]?0:1;c[j]=Math.min(p[j]+1,c[j-1]+1,p[j-1]+cost)}var t=p;p=c;c=t}
  return p[n];
}
var ALL_WORDS=[];
DATA.forEach(function(u){u.words.forEach(function(w){ALL_WORDS.push({u:u.id,w:w.w,ph:w.ph,pos:w.pos,g:w.g})})});
function distractor(word,n){
  var cand=[];
  for(var i=0;i<ALL_WORDS.length;i++){
    var x=ALL_WORDS[i];if(x.w===word.w)continue;
    var s=-levenshtein(word.w,x.w);
    if(x.w.charAt(0)===word.w.charAt(0))s+=1.5;
    if(x.w.substr(0,2)===word.w.substr(0,2))s+=1;
    if(word.pos&&x.pos&&word.pos.charAt(0)===x.pos.charAt(0))s+=0.5;
    var pf=0,L=Math.min(word.w.length,x.w.length);
    for(var k=0;k<L;k++){if(word.w.charAt(k)===x.w.charAt(k))pf++;else break}
    s+=pf*0.8;
    cand.push({x:x,s:s});
  }
  cand.sort(function(a,b){return b.s-a.s});
  return cand.slice(0,n).map(function(o){return o.x});
}

